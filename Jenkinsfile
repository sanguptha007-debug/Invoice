pipeline {
    agent any

    environment {
        // Docker Hub repository details
        DOCKER_USER = 'sanguptha'
        IMAGE_NAME  = 'invoice-system'
        TAG         = 'v1'

        // Jenkins Credential ID for Docker Hub authentication
        CRED_ID     = 'dockerhub-credentials-id'

        // Ensure Docker and Kubernetes binaries are available to Jenkins
        DOCKER_BIN  = 'C:\\Users\\sanph\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin'
        PATH        = "${DOCKER_BIN};${env.PATH}"

        // Connect Jenkins to the Docker Desktop daemon named pipe
        DOCKER_HOST = 'npipe:////./pipe/docker_engine'

        // Path to kubeconfig generated by Docker Desktop / Kubernetes
        KUBECONFIG  = 'C:\\Users\\sanph\\.kube\\config'
    }

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                bat '''
                    @echo off
                    echo === Verifying Docker CLI ===
                    docker --version
                    if errorlevel 1 exit /b 1

                    echo === Verifying Docker Daemon Connectivity ===
                    docker ps
                    if errorlevel 1 (
                        echo ERROR: Unable to communicate with Docker daemon.
                        echo Ensure Docker Desktop is running.
                        exit /b 1
                    )

                    echo === Verifying Kubernetes CLI ===
                    kubectl version --client
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %DOCKER_USER%/%IMAGE_NAME%:%TAG% .'
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${CRED_ID}",
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASS'
                    )
                ]) {
                    bat '''
                        @echo off
                        echo === Logging into Docker Hub ===
                        echo %DH_PASS% | docker login -u "%DH_USER%" --password-stdin
                        if errorlevel 1 (
                            echo ERROR: Docker login failed. Check credential ID and secrets.
                            exit /b 1
                        )

                        echo === Pushing Docker Image ===
                        docker push %DOCKER_USER%/%IMAGE_NAME%:%TAG%
                        if errorlevel 1 (
                            echo ERROR: Docker push failed.
                            exit /b 1
                        )
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat '''
                    @echo off
                    echo === Applying Kubernetes Manifest ===
                    kubectl apply -f k8s/invoice-v1.yaml
                    if errorlevel 1 (
                        echo ERROR: Kubernetes deployment failed.
                        exit /b 1
                    )

                    echo === Deployment Status ===
                    kubectl get deployment invoice-v1
                    kubectl get service invoice-v1-service
                '''
            }
        }
    }

    post {
        success {
            echo 'Invoice v1 pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the Console Output for the failing stage.'
        }
    }
}
